#!/usr/bin/env sh
# Maven Wrapper for PARIHAARAM Backend

PRG="$0"
while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/"$link"
  fi
done
PRGDIR=`dirname "$PRG"`

if [ -f "$PRGDIR/../.tools/apache-maven-3.9.6/bin/mvn" ]; then
    exec "$PRGDIR/../.tools/apache-maven-3.9.6/bin/mvn" "$@"
elif command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
else
    echo "[ERROR] Maven not found. Please ensure Maven 3.9+ is installed."
    exit 1
fi
