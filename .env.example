# Frontend: Vite uses this value for the API client (defaults to /api).
VITE_API_URL=/api

# Backend: set these in the Spring Boot process environment.
# Spring Boot does not load this file automatically.
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FILE_STORAGE_PATH=uploads/evidence
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Required when SPRING_PROFILES_ACTIVE=prod.
DATABASE_URL=jdbc:postgresql://localhost:5432/parihaaram
DATABASE_USERNAME=replace-me
DATABASE_PASSWORD=replace-me
